{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/about-us",
      "destination": "/about-us.html"
    },
    {
      "source": "/what-we-do",
      "destination": "/what-we-do.html"
    },
    {
      "source": "/who-we-are",
      "destination": "/who-we-are.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/testimonials",
      "destination": "/testimonials.html"
    },
    {
      "source": "/case-studies",
      "destination": "/case-studies.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/open-source",
      "destination": "/open-source/index.html"
    },
    {
      "source": "/agency",
      "destination": "/agency/index.html"
    },
    {
      "source": "/unified-platform",
      "destination": "/unified-platform.html"
    },
    {
      "source": "/markets",
      "destination": "/markets/index.html"
    },
    {
      "source": "/markets/:slug",
      "destination": "/markets/:slug/index.html"
    }
  ]
}
